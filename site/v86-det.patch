+// Hash maps and sets with a fixed hasher (mkb R3): std's RandomState gives
+// every new map other keys, so iteration orders depended on how many maps
+// were created before, and the JIT's choices with them.
+use std::collections::hash_map::DefaultHasher;
+use std::hash::BuildHasherDefault;
+
+pub type HashMap<K, V> = std::collections::HashMap<K, V, BuildHasherDefault<DefaultHasher>>;
+pub type HashSet<K> = std::collections::HashSet<K, BuildHasherDefault<DefaultHasher>>;
