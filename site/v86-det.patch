diff --git a/src/rust/mev.rs b/src/rust/mev.rs
new file mode 100644
index 0000000..477616f
--- /dev/null
+++ b/src/rust/mev.rs
@@ -0,0 +1,196 @@
+#![allow(non_upper_case_globals)]
+
+// mkb M1: memory events. The CPU's accesses to physical addresses outside RAM
+// (memory-mapped I/O: the legacy video window, APIC, I/O APIC, the SVGA
+// framebuffer, BIOS aliases, PCI BARs), from the interpreter and from
+// compiled code alike, are reported to the page through one import,
+// mev_cpu, while mev_on is set. Every other RAM access that is not a CPU
+// instruction's goes through the JS side's API (cpu.js dma_port, emu_write).
+//
+// Position: compiled code adds a whole block to instruction_counter when it
+// returns, and the interpreter adds a run's instructions after it, so while
+// either runs the counter holds the value at the start of the call or run.
+// jit_insn_off is the number of instructions completed in that call or run
+// before the current one: compiled code stores it before every call it makes
+// out of a block (a memory slow path, an instruction implemented by a
+// function, see jit.rs), the interpreter before every instruction.
+// mev_now() = counter + jit_insn_off is the count before the current
+// instruction, the same in compiled code, interpreted runs, a budget's
+// interpreted tail and the page's stepping.
+//
+// Checking mode (mev_track): a bitmap of the 4 KiB RAM pages the CPU may have
+// written since mev_track_begin(), which also empties the TLB: a CPU write
+// to RAM needs a TLB entry made for writing (do_page_walk marks the page
+// then) or is a physical write (memory::write8/16/32 mark it: the accessed
+// and dirty bits of page tables, the BIOS alias at 0xFFF00000). The page
+// hashes every RAM page (mev_hash_pages) at intervals: a page that changed
+// with no mark and no device or emulator event has no author.
+
+use crate::cpu::cpu::{full_clear_tlb, translate_address_read_no_side_effects};
+use crate::cpu::global_pointers::{
+    instruction_counter, instruction_pointer, memory_size, previous_ip, reg32, segment_offsets,
+};
+use crate::cpu::memory;
+use crate::cpu::misc_instr::{get_stack_pointer, getcf};
+use crate::regs::{EAX, EBX, ECX, ES, EDI};
+
+mod ext {
+    #[link(wasm_import_module = "env")]
+    extern "C" {
+        pub fn mev_cpu(kind: i32, addr: u32, lo: i32, hi: i32, count: u32, eip: i32, eip_phys: i32);
+    }
+}
+
+// kind: bit 0 write, bits 1-7 size in bytes (16 for 128-bit accesses, the
+// value is then the low 8 bytes; for a bulk copy the size is in lo and hi is
+// a hash of the bytes: bit 8), bits 9-15 what (0 an access, 1 an E820 answer)
+pub const MEV_WRITE: i32 = 1;
+pub const MEV_BULK: i32 = 1 << 8;
+pub const MEV_E820: i32 = 1 << 9;
+
+pub static mut mev_on: bool = false;
+// observe the BIOS's E820 answers (reported as MEV_E820 events)
+pub static mut mev_obs: bool = false;
+pub static mut mev_depth: u32 = 0;
+#[no_mangle]
+pub static mut jit_insn_off: u32 = 0;
+#[no_mangle]
+pub static mut mev_eip_lo: i32 = 0;
+pub static mut mev_in_jit: bool = false;
+
+pub static mut mev_track: bool = false;
+// 2 GiB of RAM at most (v86's limit): 2^31 / 4096 / 8 bytes
+pub static mut mev_dirty: [u8; 65536] = [0; 65536];
+pub static mut mev_hashes: Vec<u32> = Vec::new();
+
+// INT 15h E820h (ACPI's address map interface) in real mode: the stack
+// address of the interrupt's frame and the caller's ES:DI
+pub static mut mev_e820_frame: i32 = -1;
+pub static mut mev_e820_buf: i32 = 0;
+
+// flags: bit 0 report the CPU's accesses outside RAM, bit 1 the E820 answers
+#[no_mangle]
+pub unsafe fn mev_set(flags: u32) {
+    mev_on = flags & 1 != 0;
+    mev_obs = flags & 2 != 0;
+    mev_depth = 0;
+}
+
+// cpu.js dma_scalar: a device's access outside RAM through the CPU's
+// functions is not the CPU's
+#[no_mangle]
+pub unsafe fn mev_nest(d: i32) { mev_depth = mev_depth.wrapping_add(d as u32); }
+
+#[no_mangle]
+pub unsafe fn mev_now() -> u32 { (*instruction_counter).wrapping_add(jit_insn_off) }
+
+// The CPU's access outside RAM begins: nested ones (read16 made of two read8,
+// a device's handler that reads its own memory through the CPU's functions)
+// are not reported.
+#[inline(always)]
+pub unsafe fn enter() { mev_depth += 1; }
+
+#[inline(always)]
+pub unsafe fn leave(kind: i32, addr: u32, lo: i32, hi: i32) {
+    mev_depth -= 1;
+    if mev_on && mev_depth == 0 {
+        report(kind, addr, lo, hi);
+    }
+}
+
+#[inline(never)]
+pub unsafe fn report(kind: i32, addr: u32, lo: i32, hi: i32) {
+    let eip = if mev_in_jit { *instruction_pointer & !0xFFF | mev_eip_lo } else { *previous_ip };
+    let phys = match translate_address_read_no_side_effects(eip) {
+        Ok(p) => p as i32,
+        Err(()) => -1,
+    };
+    ext::mev_cpu(kind, addr, lo, hi, mev_now(), eip, phys);
+}
+
+// FNV-1a over 8-byte words, folded to 32 bits
+pub unsafe fn hash_bytes(p: *const u8, len: usize) -> u32 {
+    let mut h: u64 = 0xcbf29ce484222325;
+    let mut i = 0;
+    while i + 8 <= len {
+        h = (h ^ std::ptr::read_unaligned(p.add(i) as *const u64)).wrapping_mul(0x100000001b3);
+        i += 8;
+    }
+    while i < len {
+        h = (h ^ *p.add(i) as u64).wrapping_mul(0x100000001b3);
+        i += 1;
+    }
+    (h ^ h >> 32) as u32
+}
+
+#[inline(always)]
+pub unsafe fn mark(phys: u32) {
+    if mev_track {
+        let p = (phys >> 12) as usize;
+        if p < 65536 * 8 {
+            mev_dirty[p >> 3] |= 1 << (p & 7);
+        }
+    }
+}
+
+// Start an interval: no page marked, no TLB entry made before it.
+// Returns the bitmap's address in wasm memory.
+#[no_mangle]
+pub unsafe fn mev_track_begin() -> u32 {
+    (*(&raw mut mev_dirty)).fill(0);
+    mev_track = true;
+    full_clear_tlb();
+    (&raw const mev_dirty) as u32
+}
+
+#[no_mangle]
+pub unsafe fn mev_track_end() { mev_track = false; }
+
+// One hash per 4 KiB page of RAM; returns their address in wasm memory.
+#[no_mangle]
+pub unsafe fn mev_hash_pages() -> u32 {
+    let pages = (*memory_size >> 12) as usize;
+    #[allow(static_mut_refs)]
+    {
+        if mev_hashes.len() != pages {
+            mev_hashes = vec![0; pages];
+        }
+        for p in 0..pages {
+            mev_hashes[p] = hash_bytes(memory::mem8.add(p << 12), 4096);
+        }
+        mev_hashes.as_ptr() as u32
+    }
+}
+
+// instr_CD: a software interrupt in real mode
+pub unsafe fn int_sw(nr: i32, protected: bool) {
+    if mev_obs && !protected && nr == 0x15 && *reg32.offset(EAX as isize) == 0xE820 {
+        // the frame: FLAGS, CS, IP pushed below the caller's SP
+        mev_e820_frame = get_stack_pointer(0);
+        mev_e820_buf = *segment_offsets.offset(ES as isize) + (*reg32.offset(EDI as isize) & 0xFFFF);
+    }
+}
+
+// iret in real mode, before it pops the frame at sp
+pub unsafe fn iret_real(sp: i32) {
+    if mev_e820_frame == sp {
+        mev_e820_frame = -1;
+        // the answer: the entry at ES:DI, EBX the continuation, ECX the size
+        // written, CF set on an error (after the return)
+        let ebx = *reg32.offset(EBX as isize);
+        let ecx = *reg32.offset(ECX as isize);
+        let eax = *reg32.offset(EAX as isize);
+        mev_e820_pending = Some((mev_e820_buf, ebx, ecx & 0xFF | ((eax == 0x534D4150) as i32) << 8));
+    }
+}
+pub static mut mev_e820_pending: Option<(i32, i32, i32)> = None;
+
+// after the iret: report with the caller's flags in place
+pub unsafe fn iret_done() {
+    if let Some((buf, ebx, info)) = mev_e820_pending {
+        mev_e820_pending = None;
+        if mev_obs {
+            report(MEV_E820, buf as u32, ebx, info | (getcf() as i32) << 9);
+        }
+    }
+}
